# Public Supabase project connection. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server-only secrets. No NEXT_PUBLIC prefix.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
# Exact canonical origin; use your production domain after deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:8081
